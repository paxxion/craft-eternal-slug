<div class="flex flex-col items-start">
    {% if rows %}
        <table class="data fullwidth">
            <thead>
                <th>{{ 'From'|t('eternal-slug') }}</th>
                <th>{{ 'To'|t('eternal-slug') }}</th>
                <th>{{ 'Url'|t('eternal-slug') }}</th>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.dateFrom|date('d/m/Y H:i:s') }}</td>
                        <td>{{ row.dateTo|date('d/m/Y H:i:s') }}</td>
                        <td>
                            <a href="{{ row.entryUrl }}" target="_blank">{{ row.entryUrl }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        {{ 'No entries'|t('eternal-slug') }}
    {% endif %}
</div>
